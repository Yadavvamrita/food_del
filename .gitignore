# ----------------------------
# 🌐 MERN Project Git Ignore
# ----------------------------

# === Node Modules (Frontend + Backend) ===
frontend/node_modules/
backend/node_modules/

# === Build and Output Folders ===
frontend/build/
backend/build/
backend/dist/

# === Environment Files ===
frontend/.env
backend/.env
.env

# === Logs ===
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# === Coverage / Testing ===
coverage/
*.lcov

# === OS Generated Files ===
.DS_Store
Thumbs.db

# === IDE / Editor Settings ===
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln

# === Dependency Caches ===
.npm/
.cache/
.tmp/

# === Miscellaneous ===
*.pid
*.seed
*.pid.lock

# === Environment Backup Files ===
.env.local
.env.development.local
.env.test.local
.env.production.local
